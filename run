#!/usr/bin/env bash
set -euo pipefail
REPO_PATH=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
IMAGE_TAG=${MULTIPANDA_IMAGE:-multipanda-jazzy:dev}
CONTAINER_NAME=${MULTIPANDA_CONTAINER:-multipanda-jazzy}
HEADLESS=false
case "${1:-}" in
    --help|-h)
        echo "用法：./run [--headless]"
        echo "进入 Jazzy 开发容器。--headless 不转发图形界面，适用于 SSH 和自动验证。"
        echo "工作区：~/multipanda_ws；源码：~/multipanda_ws/src。"
        exit 0 ;;
    --headless) HEADLESS=true; shift ;;
    '') ;;
    *) echo "未知选项：$1" >&2; exit 2 ;;
esac
[[ $# -eq 0 ]] || { echo "参数过多；请使用 --help。" >&2; exit 2; }
"$REPO_PATH/tools/prepare_jazzy"
GUI_ARGS=()
if ! $HEADLESS && [[ -n ${DISPLAY:-} ]]; then
    command -v xhost >/dev/null && xhost +si:localuser:"$(id -un)" >/dev/null
    GUI_ARGS+=(--env "DISPLAY=$DISPLAY" --volume /tmp/.X11-unix:/tmp/.X11-unix:rw)
    [[ ! -d /dev/dri ]] || GUI_ARGS+=(--device /dev/dri)
    if command -v nvidia-smi >/dev/null && docker info --format '{{json .Runtimes}}' | grep -q nvidia; then
        GUI_ARGS+=(--gpus all --env NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display)
    fi
fi
if docker container inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
    docker start "$CONTAINER_NAME" >/dev/null
else
    docker run -d --name "$CONTAINER_NAME" --network host --ipc host \
        --cap-add SYS_NICE --ulimit rtprio=99 --ulimit memlock=-1 \
        --env "ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-1}" \
        --volume "${CONTAINER_NAME}-workspace:/home/developer/multipanda_ws" \
        --volume "$REPO_PATH:/home/developer/multipanda_ws/src" \
        "${GUI_ARGS[@]}" "$IMAGE_TAG" sleep infinity >/dev/null
fi
echo "进入 $CONTAINER_NAME。首次使用请运行 ./src/tools/build_jazzy。"
docker exec -it --user developer "$CONTAINER_NAME" bash
