#!/usr/bin/env bash
set -euo pipefail
REPO_PATH=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
IMAGE_TAG=${MULTIPANDA_IMAGE:-multipanda-jazzy:dev}
DRY_RUN=false
DOCKER_ARGS=()
BUILD_NETWORK=${MULTIPANDA_BUILD_NETWORK:-default}
for PROXY_NAME in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY; do
    if [[ -n ${!PROXY_NAME:-} ]]; then
        DOCKER_ARGS+=(--build-arg "$PROXY_NAME")
        case "${!PROXY_NAME}" in
            *://127.0.0.1:*|*://localhost:*)
                BUILD_NETWORK=${MULTIPANDA_BUILD_NETWORK:-host} ;;
        esac
    fi
done
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            echo "用法：./tools/setup_env [--dry-run] [--build-arg 名称=值]"
            echo "准备 MuJoCo 子模块，并构建 Ubuntu 24.04 / ROS 2 Jazzy 开发镜像。"
            echo "例如：./tools/setup_env --build-arg BUILD_JOBS=4"
            echo "可通过 MULTIPANDA_IMAGE 设置镜像名（默认 multipanda-jazzy:dev）。"
            exit 0 ;;
        --dry-run) DRY_RUN=true; shift ;;
        --build-arg)
            [[ $# -ge 2 ]] || { echo "--build-arg 缺少参数" >&2; exit 2; }
            DOCKER_ARGS+=(--build-arg "$2"); shift 2 ;;
        *) echo "未知选项：$1；请使用 --help。" >&2; exit 2 ;;
    esac
done
if $DRY_RUN; then
    printf '将准备子模块，并构建镜像：%s\n' "$IMAGE_TAG"
    exit 0
fi
command -v docker >/dev/null || { echo "请先安装 Docker Engine。" >&2; exit 1; }
docker info >/dev/null 2>&1 || { echo "无法连接 Docker。请检查服务和当前用户权限。" >&2; exit 1; }
"$REPO_PATH/tools/prepare_jazzy"
echo "开始构建 Jazzy 镜像；首次构建需要下载依赖。"
docker build --network "$BUILD_NETWORK" --progress=plain -t "$IMAGE_TAG" \
    --build-arg USER_UID="$(id -u)" --build-arg USER_GID="$(id -g)" \
    "${DOCKER_ARGS[@]}" -f "$REPO_PATH/tools/Dockerfile" "$REPO_PATH/tools"
echo "镜像已准备好。运行 ./run 进入环境，随后运行 ./src/tools/build_jazzy。"
